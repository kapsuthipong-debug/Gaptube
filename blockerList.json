
[
  {
    "trigger": {
      "url-filter": ".*",
      "if-domain": [
        "doubleclick.net",
        "googlesyndication.com",
        "googleadservices.com",
        "adnxs.com"
      ],
      "resource-type": [
        "image",
        "script",
        "stylesheet",
        "raw",
        "document",
        "popup"
      ]
    },
    "action": {
      "type": "block"
    }
  }
]
