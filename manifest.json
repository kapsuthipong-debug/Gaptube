
{
  "manifest_version": 3,
  "name": "Gaptube",
  "version": "1.0.0",
  "description": "A personal Safari content-blocking extension.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gaptube_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
